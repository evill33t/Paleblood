# Compile the real CLI implementation with test-only call/signal observations. Use the same
# providers and link dependencies as pbboot, so a new provider cannot silently escape the test.
if(APPLE AND TARGET guest_pointer_owned)
    get_target_property(PB_BOOT_DIRECTORY pbboot SOURCE_DIR)
    get_target_property(PB_BOOT_SOURCES pbboot SOURCES)
    get_target_property(PB_BOOT_LIBRARIES pbboot LINK_LIBRARIES)
    get_target_property(PB_BOOT_INCLUDES pbboot INCLUDE_DIRECTORIES)
    set(PB_SCOPE_SOURCES)
    foreach(source IN LISTS PB_BOOT_SOURCES)
        get_filename_component(name "${source}" NAME)
        if(name STREQUAL "boot.c")
            continue()
        endif()
        if(NOT IS_ABSOLUTE "${source}")
            set(source "${PB_BOOT_DIRECTORY}/${source}")
        endif()
        list(APPEND PB_SCOPE_SOURCES "${source}")
    endforeach()
    add_executable(test_boot_scope_darwin test/test_boot_scope_darwin.c ${PB_SCOPE_SOURCES})
    target_include_directories(test_boot_scope_darwin PRIVATE ${PB_BOOT_INCLUDES})
    target_compile_definitions(test_boot_scope_darwin PRIVATE $<TARGET_PROPERTY:pbboot,COMPILE_DEFINITIONS>)
    if(PB_ENABLE_METAL_EXECUTOR)
        foreach(provider IN ITEMS display/display_window_metal.mm display/window_mailbox.c)
            list(FIND PB_BOOT_SOURCES "${PB_BOOT_DIRECTORY}/${provider}" PB_WINDOW_PROVIDER_INDEX)
            if(PB_WINDOW_PROVIDER_INDEX EQUAL -1)
                message(FATAL_ERROR "Darwin window scope requires the actual ${provider} provider")
            endif()
        endforeach()
        foreach(library IN ITEMS pbmetal_executor pbmetal)
            list(FIND PB_BOOT_LIBRARIES "${library}" PB_WINDOW_LIBRARY_INDEX)
            if(PB_WINDOW_LIBRARY_INDEX EQUAL -1)
                message(FATAL_ERROR "Darwin window scope requires actual ${library} linkage")
            endif()
        endforeach()
        list(FIND PB_BOOT_LIBRARIES "${PB_APPKIT_FRAMEWORK}" PB_WINDOW_APPKIT_INDEX)
        if(NOT PB_APPKIT_FRAMEWORK OR PB_WINDOW_APPKIT_INDEX EQUAL -1)
            message(FATAL_ERROR "Darwin window scope requires the actual AppKit framework linkage")
        endif()
        # PRIVATE pbboot definitions do not propagate through linking.
        target_compile_definitions(test_boot_scope_darwin PRIVATE PB_METAL_WINDOW=1 PB_TEST_METAL_WINDOW=1)
    endif()
    target_compile_options(test_boot_scope_darwin PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc;-fobjc-exceptions;-fblocks;-fno-modules>")
    target_link_libraries(test_boot_scope_darwin PRIVATE ${PB_BOOT_LIBRARIES})
    add_test(NAME darwin_boot_scope COMMAND test_boot_scope_darwin)
    set_tests_properties(darwin_boot_scope PROPERTIES TIMEOUT 15)
    if(PB_ENABLE_METAL_EXECUTOR)
        add_test(NAME darwin_window_boot_scope COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/test_boot_window_scope.py")
        set_tests_properties(darwin_window_boot_scope PROPERTIES TIMEOUT 15
            ENVIRONMENT "BB_BOOT_SCOPE=$<TARGET_FILE:test_boot_scope_darwin>")
    endif()
endif()

add_test(NAME boot_owned_startup COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/test_boot_startup.py" -v)
